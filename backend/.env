# ============================================
# Konfigurasi Environment - Zero Trust PoC
# ============================================

# Server
PORT=3001

# Keycloak (Identity Provider)
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=zt-realm
KEYCLOAK_CLIENT_ID=zt-client
KEYCLOAK_CLIENT_SECRET=changeme

# OPA (Policy Engine)
OPA_URL=http://localhost:8181/v1/data/authz

# Redis (Context Store)
REDIS_URL=redis://localhost:6379

# Zero Trust Toggle (default ON)
ZT_ENABLED=true

# Risk Score Threshold
RISK_THRESHOLD=50
